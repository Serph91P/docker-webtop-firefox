#!/usr/bin/env bash
set -euo pipefail
LOG=/tmp/firefox.log
PROFILE=/config/firefox-vpn-profile
mkdir -p "$PROFILE" /config/Downloads /config/Documents

proxy="${SEALSKIN_BROWSER_PROXY-http://sealskin-vpn-proxy:8888}"
proxy_host=""
proxy_port=""
if [ -n "$proxy" ]; then
    proxy_no_scheme="${proxy#http://}"
    proxy_no_scheme="${proxy_no_scheme#https://}"
    proxy_host="${proxy_no_scheme%%:*}"
    proxy_port="${proxy_no_scheme##*:}"
fi

# Force the browser fingerprint to the known working Twitch setup on every start.
# Sealskin can inject TZ=Etc/UTC at runtime, so do not preserve inherited values here.
export TZ="Europe/Berlin"
export LANG="de_DE.UTF-8"
export LANGUAGE="de_DE:de:en_US:en"
export LC_ALL="de_DE.UTF-8"
# Force dark appearance for Firefox chrome and websites that respect prefers-color-scheme.
export GTK_THEME="Adwaita:dark"
export COLOR_SCHEME="dark"
echo "[firefox] locale TZ=$TZ LANG=$LANG LANGUAGE=$LANGUAGE LC_ALL=$LC_ALL GTK_THEME=$GTK_THEME" | tee -a "$LOG"

cat > "$PROFILE/user.js" <<EOF
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.startup.homepage", "about:blank");
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("media.eme.enabled", true);
user_pref("toolkit.telemetry.enabled", false);
user_pref("network.dns.disablePrefetch", true);
user_pref("network.predictor.enabled", false);
user_pref("media.peerconnection.enabled", false);
user_pref("privacy.resistFingerprinting", false);
user_pref("privacy.trackingprotection.enabled", false);
user_pref("privacy.trackingprotection.pbmode.enabled", false);
user_pref("intl.accept_languages", "de-DE, de, en-US, en");
user_pref("dom.security.https_only_mode", false);
user_pref("ui.systemUsesDarkTheme", 1);
user_pref("browser.theme.toolbar-theme", 0);
user_pref("browser.theme.content-theme", 0);
user_pref("layout.css.prefers-color-scheme.content-override", 0);
user_pref("widget.content.gtk-theme-override", "Adwaita:dark");
EOF

if [ -n "$proxy_host" ] && [ -n "$proxy_port" ] && [ "$proxy_host" != "$proxy_port" ]; then
    cat >> "$PROFILE/user.js" <<EOF
user_pref("network.proxy.type", 1);
user_pref("network.proxy.http", "$proxy_host");
user_pref("network.proxy.http_port", $proxy_port);
user_pref("network.proxy.ssl", "$proxy_host");
user_pref("network.proxy.ssl_port", $proxy_port);
user_pref("network.proxy.no_proxies_on", "localhost, 127.0.0.1");
user_pref("network.proxy.share_proxy_settings", true);
EOF
    echo "[firefox] using proxy $proxy" | tee -a "$LOG"
else
    echo "[firefox] proxy disabled" | tee -a "$LOG"
fi

rm -f "$PROFILE"/parent.lock "$PROFILE"/.parentlock 2>/dev/null || true
exec /usr/bin/firefox --profile "$PROFILE" --no-remote ${FIREFOX_CLI:-} ${SEALSKIN_URL:+"$SEALSKIN_URL"} ${SEALSKIN_FILE:+"$SEALSKIN_FILE"}
